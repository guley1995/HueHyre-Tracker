# --- Supabase (Projekt in Region eu-central-1 / Frankfurt) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Nur serverseitig (Export-Cron, Import-Skript, Sync-Skript). Niemals im Browser verwenden.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- Agent-API für Claude (/api/agent/*) ---
# Langer Zufallswert, z. B. `openssl rand -hex 32`. Claude schickt ihn als "Authorization: Bearer <key>".
AGENT_API_KEY=
# Direkte DB-Verbindung als Benutzer claude_agent (kein DELETE-Recht), über den Supabase-Pooler:
# postgres://claude_agent.<project-ref>:<passwort>@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
AGENT_DATABASE_URL=

# --- Nächtlicher Export (Vercel Cron) ---
# Vercel setzt CRON_SECRET automatisch als Bearer-Token für Cron-Aufrufe.
CRON_SECRET=

# --- Nur lokal: Tests gegen ein lokales Postgres ---
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/huehyre_test

# --- Nur auf dem Mac: Sync-Skript (scripts/sync) ---
TRACKER_EXPORT_DIR="/Users/<du>/Personalvermittlungen HueHyre/Tracker-Export"
TRACKER_IMPORT_DIR="/Users/<du>/Personalvermittlungen HueHyre/Tracker-Import"
TRACKER_API_URL=https://<deine-app>.vercel.app

# --- Optional: Link zur BA-Bewerberbörse im BA-Pool, {ref} wird durch die Referenznummer ersetzt ---
NEXT_PUBLIC_BA_PROFILE_URL=
